{
    "name": "php-concept/extension-logger-monolog",
    "description": "Concept Logger extension \u2014 Monolog with explicit handlers and optional data masking",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Concept\\Extensions\\LoggerMonolog\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3",
        "psr/log": "^3",
        "php-concept/extension-data-masker": "^1.0",
        "php-concept/extension-event": "^1.0",
        "php-concept/support": "^1.0",
        "league/container": "^5.1",
        "psr/event-dispatcher": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
